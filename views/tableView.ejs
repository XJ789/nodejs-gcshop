<div class="container">
    <h2><%= tableName %> 자료 목록</h2>
    <table class="table table-bordered border-primary table-hover" style="text-align: center; vertical-align: middle;">
        <thead class="table-primary">
            <tr>
                <% columns.forEach(function(col) { %>
                    <% if (col.column_comment !== 'PRIMARY KEY') { %>
                        <th><%= col.column_comment || col.column_name %></th>
                    <% } %>
                <% }); %>
                <th colspan="3"></th>
            </tr>
        </thead>
        <tbody>
            <% if (rows && rows.length > 0) { %>
                <% rows.forEach(function(row) { %>
                    <tr>
                        <% columns.forEach(function(col) { %>
                            <% if (col.column_comment !== 'PRIMARY KEY') { %>
                                <td><%= row[col.column_name] %></td>
                            <% } %>
                        <% }); %>
                        <td><a href="#" style="text-decoration: none;">생성</a></td>
                        <td><a href="#" style="text-decoration: none;">수정</a></td>
                        <td><a href="#" style="text-decoration: none;">삭제</a></td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr>
                    <td colspan="<%= columns.length + 3 %>" style="padding: 20px;">데이터가 존재하지 않습니다.</td>
                </tr>
            <% } %>
        </tbody>
    </table>
    <div class="mt-3">
        <a href="/table" class="btn btn-outline-primary btn-sm">테이블 목록 돌아가기</a>
    </div>
</div>