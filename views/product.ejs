<% if (locals.isRoot && products.length === 0) { %>
        <h1>On the Constructing....</h1>
    </div>
    <% } else { %>
        <table class="table table-bordered" style="text-align: center;">
            <thead class="table-primary ">
                <th>상품</th><th>상품명</th><th>가격</th><th>브랜드</th>
                <% if (!locals.isRoot) { %>
                    <th colspan="2"></th> 
                <% } %>
            </thead> 
            <% products.forEach(function(product) { %>
                <tr style="text-align: center; vertical-align: middle;">
                    <td><a href="/detail/<%= product.prod_id %>" style="text-decoration: none;"><img src="<%= product.image %>" style="width:100px;height:100px;object-fit: cover;"></a></td>
                    <td><%= product.name %></td>
                    <td><%= product.price %> 원</td>
                    <td><%= product.brand %></td>
                    
                    <% if (!locals.isRoot) { %>
                        <td><a href="/product/update/<%= product.prod_id %>">수정</a></td>
                        <td><a href="/product/delete/<%= product.prod_id %>" onclick="if(confirm('정말로 삭제하시겠습니까?')==false) return false">삭제</a></td>
                    <% } %>
                </tr>
                <% }); %>
        </table>
        <% if (!locals.isRoot) { %>
            <% if (products.length === 0) { %>
                <p style="margin-top: 10px; font-size: 14px;">자료가 없으니 상품 추가 버튼으로 상품을 추가해 주십시오.</p>
            <% } %>
            <br>
            <a href="/product/create"><button class="btn btn-outline-secondary btn-sm" type="submit">상품 추가</button></a>  
        <% } %>
    <% } %>