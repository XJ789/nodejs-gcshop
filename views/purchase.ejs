<div class="container">
    <table class="table table-bordered ">
        <tr class="table-light" style="text-align: center; vertical-align: middle;">
            <th>상품</th><th>상품명</th><th>단가</th><th>구매량</th><th>총금액</th><th>구매일</th><th>취소여부</th>
        </tr>
        
        <% if (typeof purchases !== 'undefined' && purchases.length > 0) { %>
            <% purchases.forEach(function(item) { %>
            <tr style="text-align: center;vertical-align: middle;">
                <td>
                    <a href="/detail/<%= item.prod_id %>">
                        <img src="<%= item.image %>" style="width:100px; height:100px; object-fit: cover;">
                    </a>
                </td>
                <td><%= item.prod_name %></td>
                <td><%= item.price.toLocaleString() %> 원</td>
                <td><%= item.qty %></td>
                <td><%= item.total.toLocaleString() %> 원</strong></td>
                <td style="font-size: 0.9em;"><%= item.date %></td>
                <td>
                    <% if (item.cancel === 'Y') { %>
                        취소된 상품
                    <% } else { %>
                        <a href="/purchase/cancel/<%= item.purchase_id %>" style="text-decoration: none;">구매취소</a>
                    <% } %>
                </td>
            </tr>
            <% }); %>
        <% } %>
    </table>
    <% if (!purchases || purchases.length === 0) { %>
        <p style="margin-top: 10px; font-size: 18px;">구매한 상품이 없습니다.</p>
    <% } %>
</div>