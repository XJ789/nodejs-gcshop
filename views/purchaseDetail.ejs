<table class="table table-bordered">
    <form method="post">
        <input type="hidden" name="prod_id" value="<%= product.prod_id %>">
        
        <tr>
            <td rowspan="5" style="width: 650px;">
                <img src="<%= product.image %>" style="width:300px; height:300px; object-fit: cover;">
            </td>
            <td><%= product.name %></td>
        </tr>
        <tr> 
            <td>가격 : <%= product.price.toLocaleString() %> 원</td>
        </tr>
        <tr> 
            <td>브랜드 : <%= product.brand %></td>
        </tr>
        <tr> 
            <td>수량 : <input type="number" name="qty"></td>
        </tr>
        <tr>
            <td style="vertical-align: middle;">
                <button class="btn btn-outline-primary btn-sm" formaction="/purchase/purchase_process" type="submit">결제</button>
                
                <button class="btn btn-outline-primary btn-sm" formaction="/purchase/cart_process" type="submit">장바구니</button>
            </td>
        </tr>
    </form>   
</table>