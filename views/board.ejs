<h1><%= btname[0].title %></h1>

<table class="table table-bordered border-primary table-hover">
    <thead class="table-primary">
        <tr>
            <th style="width: 15%;">작성자</th>
            <th>제목</th>
            <th style="width: 25%;">날짜</th>
        </tr> 
    </thead>
    <tbody>
        <% boards.forEach(function(board) { %>
            <tr>
                <td><%= board.name %></td>
                <td>
                    <% var hasReplyParam = board.reply_count > 0 ? '/Y' : ''; %>
                    <a href="/board/detail/<%= board.board_id %>/<%= pNum %><%= hasReplyParam %>" style="text-decoration: none;">
                        <%= board.title %>
                    </a>
                </td>
                <td><%= board.date %></td>
            </tr> 
            <% }); %>
    </tbody>
</table>   

<% if (boards.length === 0) { %>
    <tr>
        <td>글쓰기 버튼으로 글을 작성하세요.</td>
    </tr>
<% } %>

<div>
    <% var j = 1; %>
    <% while (j <= totalPages) { %>
        <% if (j == pNum) { %>
            <span style="font-weight: bold; font-size: 1.1em; color: #000;"><%= j %></span> &nbsp;&nbsp;
        <% } else { %>
            <span>
                <a href="/board/view/<%= btname[0].type_id %>/<%= j %>" style="text-decoration: none;">
                    <%= j %>
                </a>
            </span> &nbsp;&nbsp;
        <% } %>
        <% j++; %>
    <% } %>
</div>

<% if ((login && btname[0].write_YN === 'Y' && cls === 'CST') || cls === 'MNG') { %>
    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
       <a href="/board/create/<%= btname[0].type_id %>"> 
           <button type="button" class="btn btn-info me-md-2">글쓰기</button> 
       </a>
    </div>
<% } %>