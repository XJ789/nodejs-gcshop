<div class="container">
    <script>
        function actionCheck() {
            document.getElementById('total').value = $("input[name=check]:checked").length;
        }
    </script>
    
    <form action="/purchase/cart_purchase_process" method="post">
        <table class="table table-bordered ">
            <tr class="table-light" style="text-align: center;">
                <th>구매선택</th><th>상품</th><th>상품명</th><th>단가</th><th>담은날</th><th>수량</th>
            </tr>
            
            <% if (typeof cartItems !== 'undefined' && cartItems.length > 0) { %>
                <% cartItems.forEach(function(item) { %>
                <tr style="text-align: center; vertical-align: middle;">
                    <td><input type="checkbox" name="check" value="<%= item.cart_id %>|<%= item.prod_id %>" onchange="actionCheck()"></td>
                    <td>
                        <a href="/detail/<%= item.prod_id %>"><img src="<%= item.image %>" style="width:100px; height:100px; object-fit: cover;"></a>
                    </td>
                    <td><%= item.prod_name %></td>
                    <td><%= item.price.toLocaleString() %> 원</td>
                    <td><%= item.date %></td>
                    <td>
                        <input type="number" min="1" name="qty_<%= item.cart_id %>" value="1"> 
                    </td> 
                </tr>
                <% }); %>
            <% } %> 
        </table>
        <% if (!cartItems || cartItems.length === 0) { %>
            <p style="margin-top: 10px; font-size: 18px;">장바구니가 비어 있습니다.</p>
        <% } %>
        
        <div class="d-grid gap-2 d-md-flex justify-content-md-end align-items-center">
            <button class="btn btn-outline-primary btn-sm" type="submit" formaction="/purchase/cart_purchase_process"
            onclick="if($('input[name=check]:checked').length === 0) { alert('구매할 상품을 선택해 주세요'); return false; }">결제</button>
            <input type="hidden" id="total" name="numOfCheck" value="0"> 
            <button  class="btn btn-outline-primary btn-sm" type="submit" formaction="/purchase/cart_delete_process" 
            onclick="if($('input[name=check]:checked').length === 0) { alert('삭제할 상품을 선택해 주세요'); return false; } else { return confirm('정말로 삭제하시겠습니까?'); }">삭제</button>
            <a href='/'><button type="button" class="btn btn-outline-primary btn-sm">상품 목록 돌아가기</button></a>
        </div>
    </form>
</div>