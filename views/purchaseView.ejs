<div class="container">
    <table class="table table-bordered" style="text-align: center; vertical-align: middle;">
        <thead>
            <tr>
                <th>고객 ID</th><th>고객명</th>
                <th>상품 ID</th><th>상품명</th>
                <th>구매일</th><th>가격</th>
                <th>포인트</th><th>구매량</th>
                <th>총가격</th><th>지불여부</th><th>취소여부</th>
                <th colspan="2"></th>
            </tr>
        </thead>
        <tbody>
            <% if (purchases && purchases.length > 0) { %>
                <% purchases.forEach(function(item) { %>
                <tr>
                    <td><%= item.loginid %></td>
                    <td><%= item.user_name %></td>
                    <td><%= item.prod_id %></td>
                    <td><%= item.prod_name %></td>
                    <td style="font-size: 0.8em;"><%= item.date %></td>
                    <td><%= item.price.toLocaleString() %> 원</td>
                    <td><%= item.point %></td>
                    <td><%= item.qty %></td>
                    <td><%= item.total.toLocaleString() %> 원</td>
                    <td><%= item.payYN %></td>
                    <td><%= item.cancel %></td>
                    <td><a href="/purchaseupdate/<%= item.purchase_id %>" style="text-decoration: none;">수정</a></td>
                    <td><a href="/purchasedelete/<%= item.purchase_id %>" style="text-decoration: none;" onclick="return confirm('정말로 삭제하시겠습니까?')">삭제</a></td>
                </tr>
                <% }); %>
            <% } %>
            <% if (!purchases || purchases.length === 0) { %>
                <tr><td colspan="14" style="padding: 20px;">구매 데이터가 없습니다.</td></tr>
            <% } %>
        </tbody>
    </table>
</div>