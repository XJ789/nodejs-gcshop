<div class="container"> 
    <h2>게시글 답변</h2>

    <form action="/board/answer_process" method="post">
        <input type="hidden" name="type_id" value="<%= btname[0].type_id %>">
        <input type="hidden" name="board_id" value="<%= board.board_id %>">
        <input type="hidden" name="pNum" value="<%= pNum %>">

        <div class="mb-3">
            <label class="form-label">제목</label> 
            <input class="form-control" type="text" name="title" style="width:300px; background-color:rgb(204, 203, 203);" 
                   value="<%= board.title %>" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">작성자</label> 
            <input class="form-control" type="text" style="width:300px; background-color:rgb(204, 203, 203);" 
                   value="<%= board.author_name %>" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">작성일</label> 
            <input class="form-control" type="text" style="width:300px; background-color:rgb(204, 203, 203);" 
                   value="<%= board.date %>" readonly />
        </div>

        <div class="mb-3">
            <label class="form-label">내용</label> 
            <textarea class="form-control" style="width:100%; height: 200px; background-color:rgb(204, 203, 203);" readonly><%= board.content %></textarea>
        </div>

        <div class="mb-3 mt-4">
            <label class="form-label">답변</label> 
            <textarea class="form-control" name="content" style="width:100%; height: 150px;" required placeholder="답변을 입력해주세요."></textarea>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
            <button class="btn btn-info me-md-2" type="submit">작성</button>
            <a href="/board/view/<%= btname[0].type_id %>/<%= pNum %>"> 
                <button type="button" class="btn btn-info">목록</button> 
            </a>
        </div>
    </form>
</div>