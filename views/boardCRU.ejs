<div class="container"> 
    <% if (!isDetail) { %>
        <h2>
            <% if (isUpdate) { %> 게시판 수정 <% } 
               else { %> <%= btname[0].title %> 작성 <% } %>
        </h2>
    <% } %>

    <form action="/board/<%= isUpdate ? 'update_process' : 'create_process' %>" method="post">
        <input type="hidden" name="type_id" value="<%= btname[0].type_id %>">
        <input type="hidden" name="board_id" value="<%= board.board_id %>">
        <input type="hidden" name="pNum" value="<%= pNum %>">

        <div class="mb-3">
            <label class="form-label">제목</label> 
            <input class="form-control" type="text" name="title" style="width:300px; <%= isDetail ? 'background-color:rgb(204, 203, 203);' : '' %>"
                   value="<%= (isDetail || isUpdate) ? board.title : '' %>" 
                   <%= isDetail ? 'readonly' : '' %> required />
        </div>

        <div class="mb-3">
            <label class="form-label">작성자</label> 
            <input class="form-control" type="text" style="width:300px; background-color:rgb(204, 203, 203);"
                   value="<%= isDetail ? board.author_name : (isUpdate ? board.author_name : who) %>" 
                   readonly />
        </div>

        <% if (isDetail || isUpdate) { %>
            <div class="mb-3">
                <label class="form-label">작성일</label> 
                <input class="form-control" type="text" name="date" style="width:300px; <%= (isUpdate && cls === 'MNG') ? '' : 'background-color:rgb(204, 203, 203);' %>"
                       value="<%= board.date %>" 
                       <%= (isUpdate && cls === 'MNG') ? '' : 'readonly' %> />
            </div>
        <% } %>

        <div class="mb-3">
            <label class="form-label">내용</label> 
            <textarea class="form-control" name="content" style="width:100%; height: 200px; <%= isDetail ? 'background-color:rgb(204, 203, 203);' : '' %>"
                      <%= isDetail ? 'readonly' : '' %> required><%= (isDetail || isUpdate) ? board.content : '' %></textarea>
        </div>

        <% if (!isDetail) { %>
            <% if (cls !== 'MNG') { %>
                <div class="mb-3">
                    <label class="form-label">갱신삭제시 비밀번호</label> 
                    <input class="form-control" type="password" name="password" style="width:300px;"
                        placeholder="비밀번호를 입력하세요" required />
                    <% if (isUpdate) { %>
                        <small class="text-muted">수정하려면 원래 비밀번호를 입력해야 합니다.</small>
                    <% } %>
                </div>
            <% } %>
        <% } %>

        <div class="d-flex justify-content-between mt-4">
            <div>
                <% if (!isDetail && !isUpdate) { %>
                    <button class="btn btn-outline-primary" type="submit">생성</button>
                <% } %>
                <% if (isUpdate) { %>
                    <button class="btn btn-outline-primary" type="submit">수정완료</button>
                <% } %>
            </div>

            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <a href="/board/view/<%= btname[0].type_id %>/<%= pNum %>"> 
                    <button type="button" class="btn btn-info me-md-2">목록</button> 
                </a>

                <% if (isDetail) { %>
                    <% if (cls === 'MNG' && btname[0].re_YN === 'Y' && board.p_id === 0 && locals.hasAnswer !== 'Y') { %>
                        <a href="/board/answer/<%= board.board_id %>/<%= pNum %>"> 
                            <button type="button" class="btn btn-info me-md-2" style="border-style: dashed;">답변</button> 
                        </a>
                    <% } %>
                    <% if (cls === 'MNG' || (login && loginid === board.loginid)) { %>
                        <a href="/board/update/<%= board.board_id %>/<%= btname[0].type_id %>/<%= pNum %>"> 
                            <button type="button" class="btn btn-info me-md-2">수정</button> 
                        </a>
                        <a href="/board/delete/<%= board.board_id %>/<%= btname[0].type_id %>/<%= pNum %>" 
                           onclick="return confirm('정말로 삭제하시겠습니까?')"> 
                            <button type="button" class="btn btn-info me-md-2">삭제</button> 
                        </a>
                    <% } %>
                <% } %>
            </div>
        </div>
    </form>
</div>