<table class="table table-bordered ">
    <tr>
        <td rowspan="6">
            <img src="<%= product.image %>" style="width:300px;height:300px;object-fit: cover;">
        </td>
        <td><%= product.name %></td>
    </tr>
    <tr> <td>가격 : <%= product.price.toLocaleString() %> 원</td></tr>
    <tr> <td>브랜드 : <%= product.brand %></td></tr>
    <tr> <td>공급업체 : <%= product.supplier %></td></tr>
    <% if (login && cls === 'CST') { %>
        <tr>
            <td>
                <form action="/purchase/detail/<%= product.prod_id %>" method="get" style="display : inline-block; margin-right: 5px;">
                    <button class="btn btn-outline-primary btn-sm" type="submit">구매</button>
                </form>
                
                <form action="/purchase/cart_process" method="post" style="display : inline-block">
                    <input type="hidden" value="<%= product.prod_id %>" name="prod_id">
                    <button class="btn btn-outline-primary btn-sm" type="submit">장바구니</button>
                </form>
            </td>
        </tr>
    <% } %>
</table>