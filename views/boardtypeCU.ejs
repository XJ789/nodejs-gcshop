<div class="container">	
    <h2>게시판 <%= isUpdate ? '수정' : '생성' %></h2>
    
    <form action="/board/type/<%= isUpdate ? 'update_process' : 'create_process' %>" method="post">
        
        <% if (isUpdate) { %>
            <input type="hidden" name="type_id" value="<%= btype.type_id %>">
        <% } %>

        <div class="mb-3">
            <label class="form-label">제목</label> 
            <input class="form-control" type="text" name="title" style="width:300px;" 
                   value="<%= isUpdate ? btype.title : '' %>" />
        </div>

        <div class="mb-3">
            <label class="form-label">설명</label> 
            <input class="form-control" type="text" name="description" style="width:300px;" 
                   value="<%= isUpdate ? btype.description : '' %>" />
        </div>

        <div class="mb-3">
            <label class="form-label">페이지당 보여지는 글 수</label> 
            <input class="form-control" type="number" name="numPerPage" style="width:300px;" 
                   value="<%= isUpdate ? btype.numPerPage : '' %>" />
        </div>
        
        <% 
            var write_Y = ""; var write_N = "checked";
            if(isUpdate && btype.write_YN === 'Y') { write_Y = "checked"; write_N = ""; }
        %>
        <label class="form-label">일반 사용자 쓰기 가능 여부</label>
        <div class="mb-3">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="write_YN" id="write_YN1" value="Y" <%= write_Y %>>
                <label class="form-check-label" for="write_YN1"> Yes </label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="write_YN" id="write_YN2" value="N" <%= write_N %>>
                <label class="form-check-label" for="write_YN2"> No </label>
            </div>
        </div>

        <% 
            var re_Y = ""; var re_N = "checked";
            if(isUpdate && btype.re_YN === 'Y') { re_Y = "checked"; re_N = ""; }
        %>
        <label class="form-label">댓글 가능 여부</label> 
        <div class="mb-3">
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="re_YN" id="re_YN1" value="Y" <%= re_Y %>>
                <label class="form-check-label" for="re_YN1"> Yes </label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="re_YN" id="re_YN2" value="N" <%= re_N %>>
                <label class="form-check-label" for="re_YN2"> No </label>
            </div>
        </div>

        <hr>
        <button class="btn btn-outline-primary btn-sm" type="submit">
            <%= isUpdate ? '수정' : '생성' %>
        </button>
        <a href="/board/type/view">
            <button class="btn btn-outline-secondary btn-sm" type="button">취소</button>
        </a>
    </form>
</div>