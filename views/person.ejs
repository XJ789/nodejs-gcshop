<table class="table table-bordered border-primary table-hover" style="text-align: center;">
  <thead class="table-primary ">
      <th>ID</th><th>PW</th><th>이름</th><th>성별</th><th>주소</th><th>전화번호</th><th>생일</th><th>클래스</th><th colspan="2" >메뉴</th>
  </thead> 
  
  <% if (persons.length === 0) { %>
      <tr>
          <td></td><td></td><td></td><td></td><td></td><td></td><td></td><td></td>
          <td><a href="#" style="text-decoration: none;">수정</a></td>
          <td><a href="#" style="text-decoration: none;">삭제</a></td>
      </tr>
  <% } else { %>
      <% persons.forEach(function(person) { %>
      <tr>
          <td><%= person.loginid %></td>
          <td><%= person.password %></td>
          <td><%= person.name %></td>
          <td><%= person.mf === 'm' ? '남자' : '여자' %></td> 
          <td><%= person.address %></td>
          <td><%= person.tel %></td>
          <td><%= person.birth %></td>
          <td>
              <%= person.class === 'MNG' ? 'MNG(관리자)' : 
                 (person.class === 'CEO' ? 'CEO(경영자)' : 'CST(고객)') %>
          </td>
          <td><a href="/person/update/<%= person.loginid %>" style="text-decoration: none;">수정</a></td>
          <td><a href="/person/delete/<%= person.loginid %>" onclick='if(confirm("정말로 삭제하시겠습니까?")==false){return false}' style="text-decoration: none;">삭제</a></td>
      </tr>
      <% }); %>
  <% } %>
</table>

<% if (persons.length === 0) { %>
    <p style="margin-top: 10px; font-size: 14px;">자료가 없으니 고객 추가 버튼으로 데이터를 추가해 주십시오.</p>
<% } %>

<br>
<a href="/person/create"><button class="btn btn-outline-secondary btn-sm" type="button">고객 추가</button></a>