<div class="container"> 
    <h2>관리자 기능 : <%= isUpdate ? '회원 정보 수정' : '회원생성' %></h2>
    
    <form action="/person/<%= isUpdate ? 'update_process' : 'create_process' %>" method="post">

        <% if (!isUpdate) { %>
            <div class="mb-3">
                <label class="form-label" for="id">ID</label> 
                <input class="form-control" type="text" name="loginid" placeholder="아이디를 입력해 주세요" style="width:300px;" />
            </div>
        <% } else { %>
            <input type="hidden" name="loginid" value="<%= person.loginid %>">
        <% } %> 
        <div class="mb-3">
            <label class="form-label" for="id">PW</label> 
            <input class="form-control" type="text" name="password" placeholder="패스워드를 입력해 주세요" style="width:300px;" value="<%= isUpdate ? person.password : '' %>" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="id">이름</label> 
            <input class="form-control" type="text" name="name" placeholder="이름을 입력해 주세요" value="<%= isUpdate ? person.name : '' %>" style="width:300px;" />
        </div>
        
        <div class="mb-3">
            <label class="form-label" for="id">성별</label>&nbsp;&nbsp;&nbsp; 
            <input type="radio" name="mf" value="m" <%= isUpdate && person.mf === 'f' ? '' : 'checked' %> />&nbsp;남자&nbsp;&nbsp;&nbsp; 
            <input type="radio" name="mf" value="f" <%= isUpdate && person.mf === 'f' ? 'checked' : '' %> />&nbsp;여자
        </div>
        
        <div class="mb-3">
            <label class="form-label" for="id">주소</label> 
            <input class="form-control" type="text" name="address" placeholder="주소를 입력해 주세요" value="<%= isUpdate ? person.address : '' %>" style="width:300px;" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="id">전화번호</label> 
            <input class="form-control" type="text" name="tel" placeholder="000-0000-0000" value="<%= isUpdate ? person.tel : '' %>" style="width:300px;" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="id">생일</label> 
            <input class="form-control" type="text" name="birth" placeholder="YYYYMMDD" value="<%= isUpdate ? person.birth : '' %>" style="width:300px;" />
        </div>

        <div class="mb-3">
            <label class="form-label" for="id" style="display: inline-block; margin-right: 10px;">CLASS</label> 
            <select name="class" style="width:150px; padding: 3px;">
                <option value="CST" <%= isUpdate && person.class === 'CST' ? 'selected' : '' %>>고객</option>
                <option value="MNG" <%= isUpdate && person.class === 'MNG' ? 'selected' : '' %>>관리자</option>
                <option value="CEO" <%= isUpdate && person.class === 'CEO' ? 'selected' : '' %>>경영자</option>
            </select>
        </div>

        <button class="btn btn-outline-primary btn-sm" type="submit"><%= isUpdate ? '수정' : '입력' %></button>
        <a href="/person/view"><button class="btn btn-outline-primary btn-sm" type="button">고객 목록 돌아가기</button></a>
        
    </form> 
</div>