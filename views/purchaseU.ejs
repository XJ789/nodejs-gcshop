<div class="container">	
<h2>구매 내역 수정</h2>
    <form action="/purchaseupdate_process" method="post">
        <input type="hidden" name="purchase_id" value="<%= purchase.purchase_id %>" />
        <div class="mb-3">
            <label class="form-label" for="id">고객</label> 
            <select name="loginid" id="id">
                <% persons.forEach(function(p) { %>
                    <option value="<%= p.loginid %>" <%= purchase.loginid === p.loginid ? 'selected' : '' %>><%= p.name %></option>
                <% }); %>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="id2">상품</label> 
            <select name="prod_id" id="id2">
                <% products.forEach(function(pr) { %>
                    <option value="<%= pr.prod_id %>" <%= purchase.prod_id === pr.prod_id ? 'selected' : '' %>><%= pr.name %> (<%= pr.prod_id %>)</option>
                <% }); %>
            </select>
        </div>
        
        <table>
            <tr>
                <td>
                    <div class="mb-3" style="margin-right: 20px;">
                        <label class="form-label">날짜</label> 
                        <input class="form-control" type="text" name="date" value="<%= purchase.date %>" readonly style="width:300px; background-color:rgb(204, 203, 203);"/>
                    </div>
                </td>
                <td>
                    <div class="mb-3">
                        <label class="form-label">가격</label> 
                        <input class="form-control" type="number" name="price" value="<%= purchase.price %>" style="width:300px;"/>
                    </div>
                </td>
            </tr>
            <tr>
                <td>
                    <div class="mb-3" style="margin-right: 20px;">
                        <label class="form-label">포인트</label> 
                        <input class="form-control" type="number" name="point" value="<%= purchase.point %>" style="width:300px;"/>
                    </div>
                </td>
                <td>
                    <div class="mb-3">
                        <label class="form-label">수량</label> 
                        <input class="form-control" type="number" name="qty" value="<%= purchase.qty %>" style="width:300px;"/>
                    </div>
                </td>
            </tr>
        </table>

        <div class="mb-3">
            <label class="form-label">총액</label> 
            <input class="form-control" type="number" name="total" value="<%= purchase.total %>" style="width:300px;"/>
        </div>
        <div class="mb-3">
            <label class="form-label" for="id">지불여부</label> 
            <select name="payYN" id="id">
                <option value="Y" <%= purchase.payYN === 'Y' ? 'selected' : '' %>>YES</option>
                <option value="N" <%= purchase.payYN === 'N' ? 'selected' : '' %>>NO</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label" for="id">취소여부</label> 
            <select name="cancel" id="id">
                <option value="Y" <%= purchase.cancel === 'Y' ? 'selected' : '' %>>YES</option>
                <option value="N" <%= purchase.cancel === 'N' ? 'selected' : '' %>>NO</option>
            </select>
        </div>
        
        <button class="btn btn-outline-primary btn-sm" type="submit">수정</button>
        <a href="/purchaseview"><button class="btn btn-outline-primary btn-sm" type="button">목록으로 돌아가기</button></a>
    </form>
</div>